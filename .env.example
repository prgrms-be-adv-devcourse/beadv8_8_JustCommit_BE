# 운영 서버용 환경변수 견본입니다. 서버에서 .env로 복사한 뒤 값을 채웁니다.
# 실제 값이 들어간 .env는 커밋하지 않습니다.

# Redis 컨테이너와 Spring이 함께 사용
# openssl rand -hex 32 로 생성
REDIS_PASSWORD=

# Spring이 사용 (application-prod.yml). Spring 컨테이너가 compose에 추가되면 env_file로 전달
# 같은 compose 안에서는 서비스 이름 redis로 접속
REDIS_HOST=redis
REDIS_PORT=6379

# S3 상품·품종 이미지 (Spring이 사용). 인증은 EC2 IAM 역할(team06-replant-ec2-role)로 하므로 AWS 키는 넣지 않는다.
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=team06-replant-images
S3_PUBLIC_BASE_URL=https://team06-replant-images.s3.ap-northeast-2.amazonaws.com/
