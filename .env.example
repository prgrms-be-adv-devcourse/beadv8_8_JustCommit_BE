# 운영 서버용 환경변수 견본입니다. 서버에서 .env로 복사한 뒤 값을 채웁니다.
# 실제 값이 들어간 .env는 커밋하지 않습니다. 값을 채팅·슬랙·노션에 올리지 마세요.
# 주의: 변수를 빈 값으로 두면 yml 기본값 대신 빈 값이 들어갑니다. 필요 없는 줄은 지우세요.

# ===== 앱 =====
SPRING_APPLICATION_NAME=replant

# ===== DB (docker-compose.prod.yml의 postgres 컨테이너도 이 값으로 만들어진다) =====
DB_HOST=postgres
DB_PORT=5432
DB_NAME=replant
DB_USERNAME=replant
# openssl rand -hex 24 로 생성
DB_PASSWORD=

# ===== Redis (Redis 컨테이너와 Spring이 함께 사용) =====
REDIS_HOST=redis
REDIS_PORT=6379
# openssl rand -hex 32 로 생성
REDIS_PASSWORD=

# ===== Kafka (같은 compose 안의 kafka 컨테이너) =====
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ===== 로그인·보안 =====
# openssl rand -base64 32 로 생성 (32글자 이상)
JWT_SECRET=
# 환급 계좌번호 암호화 키. openssl rand -base64 32 로 생성
# 잃어버리면 저장된 계좌를 복호화할 수 없으므로 비밀번호 관리자에 따로 백업하고, 다시 생성하지 않는다.
ACCOUNT_ENCRYPTION_KEY=
# 카카오 개발자 콘솔에서 확인. 비어 있으면 Spring이 기동에 실패한다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# HTTPS 운영이면 true (Secure 쿠키는 HTTPS에서만 전송된다)
COOKIE_SECURE=true
# 소셜 로그인 후 돌아갈 프론트 주소
FRONTEND_BASE_URL=

# ===== S3 상품·품종 이미지 =====
# 인증은 EC2 IAM 역할(team06-replant-ec2-role)로 하므로 AWS 키는 넣지 않는다.
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=team06-replant-images
S3_PUBLIC_BASE_URL=https://team06-replant-images.s3.ap-northeast-2.amazonaws.com/

# ===== 외부 연동 =====
# 토스페이먼츠 개발자센터의 테스트 시크릿 키
TOSS_SECRET_KEY=
# 메일 발송용 Gmail 주소와 앱 비밀번호 (계정 비밀번호 아님)
MAIL_USERNAME=
MAIL_PASSWORD=
# 모의 택배사(404-express). 같은 EC2의 공유 네트워크 replant-net으로 통신한다 (외부·보안 그룹에 열지 않음)
# 주소: 404-express 컨테이너의 replant-net 별칭
COURIER_BASE_URL=http://404-express:3000
# 우리 → 택배사 요청의 X-Api-Key. openssl rand -hex 32 로 만들고 404-express .env의 COURIER_API_KEY와 같은 값
COURIER_API_KEY=
# 택배사 → 우리 웹훅의 X-Api-Key. openssl rand -hex 32 로 만들고 404-express .env의 WEBHOOK_API_KEY와 같은 값
# (404-express의 WEBHOOK_URL=http://replant-app:8080/api/v1/webhooks/courier). 비어 있으면 웹훅이 전부 401
WEBHOOK_API_KEY=
